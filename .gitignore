# Service account credentials.
# The bare filename is listed explicitly: the wildcard patterns below require a
# prefix, so "service-account.json" — the name deploy.sh actually uploads — would
# otherwise be committed.
service-account.json
*credentials.json
*service-account.json
firebase-adminsdk*.json

