# ========================
# DompetCerdas Go Backend
# ========================

# --- Firebase ---
# GCP project ID for Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Firebase Storage bucket (optional, defaults to {project-id}.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Telegram Bot ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Webhook secret for verifying Telegram webhook requests (optional)
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# --- AI ---
# Google Gemini API key (direct, spending-cap)
GEMINI_API_KEY=your-gemini-api-key

# --- Antigravity (Google One OAuth via Antigravity proxy, preferred)
# OpenAI-compatible proxy at http://127.0.0.1:3000/v1 on the same host
ANTIGRAVITY_BASE_URL=http://127.0.0.1:3000/v1
ANTIGRAVITY_API_KEY=your-antigravity-proxy-key
ANTIGRAVITY_MODEL=gemini-3.6-flash-high

# --- Server ---
# HTTP listen port (default: 8080)
PORT=8080

# Environment: development | staging | production
ENV=development

# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- Timezone ---
# IANA timezone for date logic and cron (default: Asia/Jakarta)
TZ=Asia/Jakarta
